# Clé OpenAI (laisser vide pour le mode local de secours)
OPENAI_API_KEY=

# Port du serveur (défaut: 3000)
PORT=3000

# Réglages IA (optionnels)
MODEL_TEXT=gpt-4o-mini
MODEL_IMAGE=gpt-image-1

# Réglages coût/latence (optionnels)
# Nombre de pages d'histoire (hors couverture): ex 6
PAGE_COUNT=6
# Taille des images IA: 256x256, 512x512, 1024x1024
IMAGE_SIZE=256x256

# Forcer le mode local (sans OpenAI) : true/false
FORCE_LOCAL=false
